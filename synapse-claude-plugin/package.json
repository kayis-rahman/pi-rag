{
  "name": "synapse-claude-plugin",
  "displayName": "Synapse Claude Plugin",
  "description": "Claude Code plugin for Synapse RAG system integration",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onCommand:synapse.analyze",
    "onCommand:synapse.generateDocs",
    "onCommand:synapse.searchKnowledge"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "synapse.analyze",
        "title": "Synapse: Analyze Current File"
      },
      {
        "command": "synapse.generateDocs",
        "title": "Synapse: Generate Documentation"
      },
      {
        "command": "synapse.searchKnowledge",
        "title": "Synapse: Search Knowledge Base"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "synapse.analyze",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./lib/testRunner.js"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "@anthropic/mcp-client": "^0.1.0"
  }
}