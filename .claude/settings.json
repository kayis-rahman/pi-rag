{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(xcodebuild:*)",
      "Bash(docker compose:*)",
      "Bash(docker:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(pkill:*)",
      "Bash(curl:*)",
      "Bash(ssh:*)",
      "Bash(psql:*)",
      "Bash(npx:*)",
      "Bash(xcrun:*)",
      "Bash(system_profiler:*)",
      "Bash(tee:*)",
      "Bash(ipconfig:*)",
      "Bash(security:*)",
      "Bash(kill:*)",
      "Bash(ideviceinstaller:*)",
      "Bash(swift:*)",
      "Bash(java:*)",
      "Read(//Applications/**)",
      "Read(//Library/Developer/**)",
      "WebSearch",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:www.oracle.com)",
      "WebFetch(domain:docs.spring.io)",
      "WebFetch(domain:kotlinlang.org)",
      "WebFetch(domain:www.postgresql.org)",
      "WebFetch(domain:api.github.com)",
      "Skill(gsd:update)",
      "Skill(review)",
      "Skill(everything-claude-code:liquid-glass-design)"
    ],
    "defaultMode": "plan"
  },
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://timebeam:timebeam@localhost:5432/timebeam_e2e"
      ],
      "env": {},
      "enabled": true,
      "muteAlerts": false
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/SessionStart.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/PreCommit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/PostBuild.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/PreCompact.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/SessionComplete.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
