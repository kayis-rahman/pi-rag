[Unit]
Description=llama.cpp LLM Server
After=network.target

[Service]
Type=notify
User=pi
WorkingDirectory=/home/pi/llama.cpp
ExecStart=/home/pi/llama.cpp/build/bin/llama-server \
    --model /home/pi/models/gemma-4-e4b-q4.gguf \
    --host 127.0.0.1 \
    --port 8081 \
    --ctx-size 131072 \
    --n-gpu-layers 99 \
    --timeout 300
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target