package com.sparkage.timebeam.application.service;

import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import com.sparkage.timebeam.domain.model.User;
import com.sparkage.timebeam.infrastructure.persistence.UserDevice;
import com.sparkage.timebeam.infrastructure.persistence.UserDeviceRepository;
import com.sparkage.timebeam.application.dto.DeviceHeartbeatDto;

import java.time.Instant;
import java.util.List;
import java.util.UUID;
import java.util.concurrent.ConcurrentHashMap;
import java.util.Map;

@Service
public class DeviceHeartbeatService {
    private static final Logger log = LoggerFactory.getLogger(DeviceHeartbeatService.class);
    private static final Duration INACTIVE_THRESHOLD = Duration.ofMinutes(5);
    
    private final UserDeviceRepository deviceRepository;
    
    // In-memory cache for active device tracking
    private final Map<UUID, Map<String, Instant>> activeDevices = new ConcurrentHashMap<>();
    
    public DeviceHeartbeatService(UserDeviceRepository deviceRepository) {
        this.deviceRepository = deviceRepository;
    }
    
    /**
     * Record heartbeat from active device
     */
    @Transactional
    public void recordHeartbeat(UUID userId, String deviceId, String platform) {
        log.debug("Recording heartbeat for user={}, device={}, platform={}", userId, deviceId, platform);
        
        // Update last seen timestamp and mark as active
        UserDevice device = deviceRepository.findByUserIdAndDeviceId(userId, deviceId)
            .orElseGet(() -> createDevice(userId, deviceId, platform));
        
        device.setLastSeenAt(Instant.now());
        device.setActive(true);
        deviceRepository.save(device);
        
        // Update in-memory cache
        activeDevices.computeIfAbsent(userId, k -> new ConcurrentHashMap<>())
            .put(deviceId, Map.of(
                "lastSeen", Instant.now(),
                "platform", platform,
                "timestamp", Instant.now()
            ));
        
        log.debug("Heartbeat recorded for user={}, device={}", userId, deviceId);
    }
    
    /**
     * Get all currently active devices for a user
     */
    public List<DeviceHeartbeatDto> getActiveDevices(UUID userId) {
        return activeDevices.getOrDefault(userId, new ConcurrentHashMap<>())
            .entrySet().stream()
            .map(entry -> DeviceHeartbeatDto.builder()
                .deviceId(entry.getKey())
                .platform((String) entry.getValue().get("platform"))
                .lastSeenAt((Instant) entry.getValue().get("lastSeen"))
                .active(true)
                .build())
            .toList();
    }
    
    /**
     * Deactivate device (mark as inactive)
     */
    @Transactional
    public void deactivateDevice(UUID userId, String deviceId) {
        log.debug("Deactivating device for user={}, device={}", userId, deviceId);
        
        UserDevice device = deviceRepository.findByUserIdAndDeviceId(userId, deviceId)
            .orElse(null);
        
        if (device != null) {
            device.setActive(false);
            deviceRepository.save(device);
            
            // Remove from in-memory cache
            activeDevices.computeIfPresent(userId, deviceMap -> {
                deviceMap.remove(deviceId);
            });
        }
    }
    
    /**
     * Cleanup stale devices (auto-deactivation)
     */
    @Transactional
    public int cleanupStaleDevices() {
        Instant cutoff = Instant.now().minus(INACTIVE_THRESHOLD);
        List<UserDevice> staleDevices = deviceRepository.findStaleDevices(cutoff);
        
        for (UserDevice device : staleDevices) {
            device.setActive(false);
            deviceRepository.save(device);
            
            // Remove from active devices cache
            activeDevices.computeIfPresent(device.getUserId(), deviceMap -> {
                deviceMap.remove(device.getDeviceId());
            });
        }
        
        log.info("Cleaned up {} stale devices", staleDevices.size());
        return staleDevices.size();
    }
    
    /**
     * Get device activity summary for debugging/monitoring
     */
    public Map<UUID, List<DeviceHeartbeatDto>> getDeviceActivitySummary() {
        return activeDevices.entrySet().stream()
            .collect(java.util.stream.Collectors.toMap(
                Map.Entry::getKey,
                Map.Entry::getValue
            ));
    }
    
    private UserDevice createDevice(UUID userId, String deviceId, String platform) {
        return UserDevice.builder()
                .id(UUID.randomUUID())
                .userId(userId)
                .deviceId(deviceId)
                .deviceName(generateDeviceName(platform))
                .platform(platform)
                .active(true)
                .lastSeenAt(Instant.now())
                .createdAt(Instant.now())
                .build();
    }
    
    private String generateDeviceName(String platform) {
        switch (platform.toLowerCase()) {
            case "ios":
                return "iPhone/iPad";
            case "macos":
                return "Mac";
            case "watchos":
                return "Apple Watch";
            default:
                return "Unknown Device";
        }
    }
    
    private void updateDeviceInfo(UserDevice device, DeviceRegistrationDto registration) {
        if (registration.getDeviceName() != null) {
            device.setDeviceName(registration.getDeviceName());
        }
        if (registration.getPushToken() != null && !registration.getPushToken().isEmpty()) {
            device.setPushToken(registration.getPushToken());
        }
        device.setLastSeenAt(Instant.now());
    }
}