<?xml version="1.0" encoding="UTF-8"?>
<JaCoCoAgentConfiguration>
    <!--
        JaCoCo Agent Configuration for Synapse Backend

        This configuration controls how JaCoCo instruments the application
        during test execution for code coverage measurement.
    -->

    <!-- Output file for coverage data -->
    <output>file</output>

    <!-- Output file location (relative to working directory) -->
    <destFile>target/jacoco.exec</destFile>

    <!-- Output file for integration test coverage -->
    <destFile>target/jacoco-it.exec</destFile>

    <!-- Append to existing coverage data (for parallel test execution) -->
    <append>false</append>

    <!-- Classes to include in coverage measurement -->
    <includes>
        <include>**/com/sparkage/synapse/**</include>
    </includes>

    <!-- Classes to exclude from coverage measurement -->
    <excludes>
        <!-- Generated code -->
        <exclude>**/generated/**</exclude>
        <exclude>**/generated-sources/**</exclude>

        <!-- Model/Entity classes (typically simple POJOs) -->
        <exclude>**/model/**</exclude>
        <exclude>**/domain/model/**</exclude>

        <!-- DTO classes (data transfer objects) -->
        <exclude>**/dto/**</exclude>
        <exclude>**/presentation/dto/**</exclude>

        <!-- Configuration classes -->
        <exclude>**/config/**</exclude>
        <exclude>**/infrastructure/config/**</exclude>

        <!-- Exception classes -->
        <exclude>**/exception/**</exclude>
        <exclude>**/*Exception.class</exclude>

        <!-- Application entry point -->
        <exclude>**/Application.class</exclude>
        <exclude>**/SynapseApplication.class</exclude>

        <!-- Main method stubs -->
        <exclude>**/*Kt.class</exclude>
    </excludes>

    <!-- Class loader for JaCoCo runtime -->
    <classloader>standard</classloader>

    <!-- Session ID for multi-process scenarios -->
    <sessionId>${session.id}</sessionId>

    <!-- Dump on exit -->
    <dumponexit>true</dumponexit>

    <!-- JMX interface for runtime control -->
    <jmx>false</jmx>

    <!-- Include location in generated data (for source code linking) -->
    <inclnolocation>false</inclnolocation>

    <!-- Include bootstrap classloader classes -->
    <inclbootstrapclasses>false</inclbootstrapclasses>

    <!-- Include classloader classes -->
    <inclclassloaderclasses>false</inclclassloaderclasses>
</JaCoCoAgentConfiguration>
