# Stage 1: Build the native image
FROM container-registry.oracle.com/graalvm/native-image:17-muslib as builder

# Install necessary build tools
RUN microdnf install -y maven curl

WORKDIR /app
COPY pom.xml .
COPY src src/

# Cache Maven dependencies and build native image
RUN --mount=type=cache,target=/root/.m2 mvn -Pnative -DskipTests clean package

# Stage 2: Create minimal runtime image
FROM debian:bullseye-slim

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the native executable
COPY --from=builder /app/target/timebeam-backend .

# Make the application executable
RUN chmod +x ./timebeam-backend

# Expose port
EXPOSE 8080

# Set production environment
ENV SPRING_PROFILES_ACTIVE=prod

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the application with specific user
RUN groupadd -r backend && useradd -r -g backend backend
RUN chown -R backend:backend /app
USER backend

ENTRYPOINT ["./timebeam-backend"]
