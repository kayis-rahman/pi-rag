    COALESCE(SUM(CASE WHEN sr.duration_seconds IS NOT NULL THEN sr.duration_seconds / 60 END), 0) as total_time_spent
FROM tasks t
LEFT JOIN session_records sr ON sr.task_id = t.id AND sr.kind = 'WORK'
WHERE t.user_id = ?::uuid
]
