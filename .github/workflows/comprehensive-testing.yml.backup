name: Comprehensive Testing Suite

on:
  push:
    branches: [ main, develop, feature/**, bugfix/** ]
  pull_request:
    branches: [ main, develop, feature/**, bugfix/** ]
  workflow_dispatch:
    inputs:
      test_focus:
        description: 'Test focus area'
        required: false
        default: 'all'
        type: choice
        options:
        - all
        - backend
        - ios
        - macos
        - watchos

env:
  JAVA_VERSION: 17

jobs:
  # ===== BACKEND BUILD =====
  backend-build:
    name: 🔧 Backend Build (Maven)
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: timebeam_dev
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Java
      uses: actions/setup-java@v4
      with:
        java-version: ${{ env.JAVA_VERSION }}
        distribution: 'temurin'

    - name: Cache Maven packages
      uses: actions/cache@v4
      with:
        path: ~/.m2
        key: ${{ runner.os }}-m2-${{ hashFiles('**/pom.xml') }}
        restore-keys: ${{ runner.os }}-m2

    - name: Setup test database
      run: |
        cd back-end
        PGPASSWORD=postgres psql -h localhost -U postgres -d timebeam_dev -f db/schema.sql || true
        PGPASSWORD=postgres psql -h localhost -U postgres -d timebeam_dev -f db/migration.sql || true

    - name: Build backend
      run: |
        cd back-end
        mvn clean compile -DskipTests --batch-mode --no-transfer-progress

    - name: Package backend
      run: |
        cd back-end
        mvn package -DskipTests --batch-mode --no-transfer-progress

    - name: Upload backend build artifacts
      uses: actions/upload-artifact@v4
      with:
        name: backend-build-artifacts
        path: |
          back-end/target/*.jar
          back-end/pom.xml

  # ===== BACKEND TESTS =====
  backend-tests:
    name: 🧪 Backend Tests (Unit & Integration)
    runs-on: ubuntu-latest
    needs: backend-build
    services:
      postgres:
        image: postgres:15
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: timebeam_test
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Java
      uses: actions/setup-java@v4
      with:
        java-version: ${{ env.JAVA_VERSION }}
        distribution: 'temurin'

    - name: Cache Maven packages
      uses: actions/cache@v4
      with:
        path: ~/.m2
        key: ${{ runner.os }}-m2-${{ hashFiles('**/pom.xml') }}

    - name: Setup test database
      run: |
        cd back-end
        PGPASSWORD=postgres psql -h localhost -U postgres -d timebeam_test -f db/schema.sql || true
        PGPASSWORD=postgres psql -h localhost -U postgres -d timebeam_test -f db/migration.sql || true

    - name: Download backend build artifacts
      uses: actions/download-artifact@v4
      with:
        name: backend-build-artifacts
        path: back-end/target/

    - name: Run backend unit tests
      run: |
        cd back-end
        mvn test -Dtest="*Test" -DfailIfNoTests=false --batch-mode --no-transfer-progress

    - name: Run backend integration tests
      run: |
        cd back-end
        mvn test -Dtest="*IT" -DfailIfNoTests=false --batch-mode --no-transfer-progress

    - name: Generate Jacoco coverage report
      run: |
        cd back-end
        mvn jacoco:prepare-agent test jacoco:report --batch-mode --no-transfer-progress

    - name: Upload backend coverage to Codecov
      uses: codecov/codecov-action@v4
      with:
        file: back-end/target/site/jacoco/jacoco.xml
        flags: backend
        name: Backend Coverage
        fail_ci_if_error: false

    - name: Generate test summary
      run: |
        cd back-end
        echo "## Backend Test Results" > test-summary.md
        echo "" >> test-summary.md

        # Count total tests, failures, errors
        TOTAL_TESTS=$(find target/surefire-reports -name "*.xml" -exec grep -h "<testsuite" {} \; 2>/dev/null | sed 's/.*tests="\([^"]*\)".*/\1/g' | awk '{sum += $1} END {print sum}')
        TOTAL_FAILURES=$(find target/surefire-reports -name "*.xml" -exec grep -h "<testsuite" {} \; 2>/dev/null | sed 's/.*failures="\([^"]*\)".*/\1/g' | awk '{sum += $1} END {print sum}')
        TOTAL_ERRORS=$(find target/surefire-reports -name "*.xml" -exec grep -h "<testsuite" {} \; 2>/dev/null | sed 's/.*errors="\([^"]*\)".*/\1/g' | awk '{sum += $1} END {print sum}')

        echo "📊 **Total Tests:** ${TOTAL_TESTS:-0}" >> test-summary.md
        echo "❌ **Failures:** ${TOTAL_FAILURES:-0}" >> test-summary.md
        echo "🔥 **Errors:** ${TOTAL_ERRORS:-0}" >> test-summary.md

        if [ "${TOTAL_FAILURES:-0}" -eq 0 ] && [ "${TOTAL_ERRORS:-0}" -eq 0 ]; then
          echo "✅ **Status:** PASSED" >> test-summary.md
        else
          echo "❌ **Status:** FAILED" >> test-summary.md
        fi

        echo "" >> test-summary.md
        echo "### Coverage Report" >> test-summary.md

        if [ -f "target/site/jacoco/index.html" ]; then
          echo "📈 Jacoco coverage report generated" >> test-summary.md
        fi

    - name: Upload backend test results
      uses: actions/upload-artifact@v4
      if: always()
      with:
        name: backend-test-results
        path: |
          back-end/target/surefire-reports/
          back-end/target/site/jacoco/
          back-end/test-summary.md

  # ===== iOS BUILD =====
  ios-build:
    name: 📱 iOS Build
    runs-on: macos-latest
    needs: backend-tests

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Xcode
      uses: maxim-lobanov/setup-xcode@v1
      with:
        xcode-version: latest-stable

    - name: Cache CocoaPods
      uses: actions/cache@v4
      with:
        path: apple/TimeBeam/TimeBeam/Pods
        key: ${{ runner.os }}-pods-${{ hashFiles('apple/TimeBeam/TimeBeam/Podfile.lock') }}
        restore-keys: ${{ runner.os }}-pods-

    - name: Install dependencies
      run: |
        cd apple/TimeBeam
        pod install --silent

    - name: Build iOS app for testing
      run: |
        cd apple/TimeBeam
        xcodebuild build \
          -workspace TimeBeam.xcworkspace \
          -scheme "TimeBeam iOS" \
          -destination "platform=iOS Simulator,name=iPhone 15,OS=latest" \
          -configuration Debug \
          ONLY_ACTIVE_ARCH=YES \
          CODE_SIGNING_ALLOWED=NO

    - name: Upload iOS build artifacts
      uses: actions/upload-artifact@v4
      with:
        name: ios-build-artifacts
        path: |
          apple/TimeBeam/build/
          apple/TimeBeam/TimeBeam.xcworkspace/
          apple/TimeBeam/TimeBeam.xcodeproj/

  # ===== iOS TESTS =====
  ios-tests:
    name: 🧪 iOS Tests
    runs-on: macos-latest
    needs: ios-build
    strategy:
      matrix:
        device: ['iPhone 15']
        test_type: ['unit', 'ui', 'e2e']
        include:
          - device: 'iPhone 15'
            destination: 'platform=iOS Simulator,name=iPhone 15,OS=latest'

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Xcode
      uses: maxim-lobanov/setup-xcode@v1
      with:
        xcode-version: latest-stable

    - name: Download iOS build artifacts
      uses: actions/download-artifact@v4
      with:
        name: ios-build-artifacts
        path: apple/TimeBeam/

    - name: Cache CocoaPods
      uses: actions/cache@v4
      with:
        path: apple/TimeBeam/TimeBeam/Pods
        key: ${{ runner.os }}-pods-${{ hashFiles('apple/TimeBeam/TimeBeam/Podfile.lock') }}
        restore-keys: ${{ runner.os }}-pods-

    - name: Install dependencies
      run: |
        cd apple/TimeBeam
        pod install --silent

    - name: Run iOS Unit Tests
      if: matrix.test_type == 'unit'
      run: |
        cd apple/TimeBeam
        xcodebuild test \
          -workspace TimeBeam.xcworkspace \
          -scheme "TimeBeam iOS" \
          -destination "${{ matrix.destination }}" \
          -resultBundlePath UnitTestResults \
          -enableCodeCoverage YES \
          ONLY_ACTIVE_ARCH=YES \
          -testPlan UnitTests

    - name: Run iOS UI Tests
      if: matrix.test_type == 'ui'
      run: |
        cd apple/TimeBeam
        xcodebuild test \
          -workspace TimeBeam.xcworkspace \
          -scheme "TimeBeam iOS" \
          -destination "${{ matrix.destination }}" \
          -resultBundlePath UITestResults \
          ONLY_ACTIVE_ARCH=YES \
          -testPlan UITests

    - name: Run iOS E2E Tests
      if: matrix.test_type == 'e2e'
      run: |
        cd apple/TimeBeam
        xcodebuild test \
          -workspace TimeBeam.xcworkspace \
          -scheme "TimeBeam iOS" \
          -destination "${{ matrix.destination }}" \
          -resultBundlePath E2ETestResults \
          ONLY_ACTIVE_ARCH=YES \
          -testPlan E2ETests

    - name: Generate iOS test summary
      run: |
        cd apple/TimeBeam
        echo "## iOS ${{ matrix.test_type }} Test Results (${{ matrix.device }})" > test-summary-${{ matrix.test_type }}.md
        echo "" >> test-summary-${{ matrix.test_type }}.md

        # Check if test results exist
        if [ -d "${{ matrix.test_type }}TestResults.xcresult" ]; then
          echo "📊 **Test Bundle:** ${{ matrix.test_type }}TestResults.xcresult" >> test-summary-${{ matrix.test_type }}.md
          echo "✅ **Status:** Tests executed" >> test-summary-${{ matrix.test_type }}.md
        else
          echo "❌ **Status:** No test results found" >> test-summary-${{ matrix.test_type }}.md
        fi

    - name: Upload iOS test results
      uses: actions/upload-artifact@v4
      if: always()
      with:
        name: ios-${{ matrix.test_type }}-test-results
        path: |
          apple/TimeBeam/*TestResults.xcresult
          apple/TimeBeam/test-summary-${{ matrix.test_type }}.md

  # ===== macOS TESTS =====
  macos-tests:
    name: 🧪 macOS Tests
    runs-on: macos-latest
    needs: ios-tests

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Xcode
      uses: maxim-lobanov/setup-xcode@v1
      with:
        xcode-version: latest-stable

    - name: Cache CocoaPods
      uses: actions/cache@v4
      with:
        path: apple/TimeBeam/TimeBeam/Pods
        key: ${{ runner.os }}-pods-${{ hashFiles('apple/TimeBeam/TimeBeam/Podfile.lock') }}
        restore-keys: ${{ runner.os }}-pods-

    - name: Install dependencies
      run: |
        cd apple/TimeBeam
        pod install --silent

    - name: Run macOS Unit Tests
      run: |
        cd apple/TimeBeam
        xcodebuild test \
          -workspace TimeBeam.xcworkspace \
          -scheme "TimeBeam macOS" \
          -destination "platform=macOS,arch=x86_64" \
          -resultBundlePath UnitTestResults \
          -enableCodeCoverage YES \
          ONLY_ACTIVE_ARCH=YES

    - name: Run macOS UI Tests
      run: |
        cd apple/TimeBeam
        xcodebuild test \
          -workspace TimeBeam.xcworkspace \
          -scheme "TimeBeam macOS" \
          -destination "platform=macOS,arch=x86_64" \
          -resultBundlePath UITestResults \
          ONLY_ACTIVE_ARCH=YES

    - name: Generate macOS test summary
      run: |
        cd apple/TimeBeam
        echo "## macOS Test Results" > test-summary.md
        echo "" >> test-summary.md

        if [ -d "UnitTestResults.xcresult" ]; then
          echo "📊 **Unit Tests:** Executed" >> test-summary.md
        fi

        if [ -d "UITestResults.xcresult" ]; then
          echo "📊 **UI Tests:** Executed" >> test-summary.md
        fi

        echo "✅ **Status:** Tests completed" >> test-summary.md

    - name: Upload macOS test results
      uses: actions/upload-artifact@v4
      if: always()
      with:
        name: macos-test-results
        path: |
          apple/TimeBeam/UnitTestResults.xcresult
          apple/TimeBeam/UITestResults.xcresult
          apple/TimeBeam/test-summary.md

  # ===== watchOS TESTS =====
  watchos-tests:
    name: 🧪 watchOS Tests
    runs-on: macos-latest
    needs: macos-tests

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Setup Xcode
      uses: maxim-lobanov/setup-xcode@v1
      with:
        xcode-version: latest-stable

    - name: Cache CocoaPods
      uses: actions/cache@v4
      with:
        path: apple/TimeBeam/TimeBeam/Pods
        key: ${{ runner.os }}-pods-${{ hashFiles('apple/TimeBeam/TimeBeam/Podfile.lock') }}
        restore-keys: ${{ runner.os }}-pods-

    - name: Install dependencies
      run: |
        cd apple/TimeBeam
        pod install --silent

    - name: Run watchOS Unit Tests
      run: |
        cd apple/TimeBeam
        xcodebuild test \
          -workspace TimeBeam.xcworkspace \
          -scheme "TimeBeamWatch Watch App" \
          -destination "platform=watchOS Simulator,name=Apple Watch Series 8,OS=latest" \
          -resultBundlePath UnitTestResults \
          -enableCodeCoverage YES \
          ONLY_ACTIVE_ARCH=YES

    - name: Generate watchOS test summary
      run: |
        cd apple/TimeBeam
        echo "## watchOS Test Results" > test-summary.md
        echo "" >> test-summary.md

        if [ -d "UnitTestResults.xcresult" ]; then
          echo "📊 **Unit Tests:** Executed" >> test-summary.md
          echo "✅ **Status:** Tests completed" >> test-summary.md
        else
          echo "❌ **Status:** No test results found" >> test-summary.md
        fi

    - name: Upload watchOS test results
      uses: actions/upload-artifact@v4
      if: always()
      with:
        name: watchos-test-results
        path: |
          apple/TimeBeam/UnitTestResults.xcresult
          apple/TimeBeam/test-summary.md

  # ===== FINAL REPORT & NOTIFICATIONS =====
  final-report:
    name: 📊 Final Test Report & Notifications
    runs-on: macos-latest
    needs: [backend-tests, ios-tests, macos-tests, watchos-tests]
    if: always()

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Download all test artifacts
      uses: actions/download-artifact@v4

    - name: Generate comprehensive test report
      run: |
        echo "# 🚀 Comprehensive Test Suite Report" > final-report.md
        echo "" >> final-report.md
        echo "## Execution Summary" >> final-report.md
        echo "- **Date:** $(date)" >> final-report.md
        echo "- **Commit:** ${{ github.sha }}" >> final-report.md
        echo "- **Branch:** ${{ github.ref }}" >> final-report.md
        echo "" >> final-report.md

        # Backend results
        echo "## 🔧 Backend Tests" >> final-report.md
        if [ -f "backend-test-results/test-summary.md" ]; then
          cat backend-test-results/test-summary.md >> final-report.md
        else
          echo "❌ No backend test results found" >> final-report.md
        fi
        echo "" >> final-report.md

        # iOS results
        echo "## 📱 iOS Tests" >> final-report.md
        IOS_PASSED=true
        for test_type in unit ui e2e; do
          if [ -f "ios-${test_type}-test-results/test-summary-${test_type}.md" ]; then
            echo "### ${test_type^} Tests" >> final-report.md
            cat ios-${test_type}-test-results/test-summary-${test_type}.md >> final-report.md
            echo "" >> final-report.md
          else
            echo "❌ iOS ${test_type} test results missing" >> final-report.md
            IOS_PASSED=false
          fi
        done

        # macOS results
        echo "## 💻 macOS Tests" >> final-report.md
        if [ -f "macos-test-results/test-summary.md" ]; then
          cat macos-test-results/test-summary.md >> final-report.md
        else
          echo "❌ No macOS test results found" >> final-report.md
        fi
        echo "" >> final-report.md

        # watchOS results
        echo "## ⌚ watchOS Tests" >> final-report.md
        if [ -f "watchos-test-results/test-summary.md" ]; then
          cat watchos-test-results/test-summary.md >> final-report.md
        else
          echo "❌ No watchOS test results found" >> final-report.md
        fi
        echo "" >> final-report.md

        # Overall status
        echo "## 📈 Overall Status" >> final-report.md

        BACKEND_STATUS="❌ FAILED"
        IOS_STATUS="❌ FAILED"
        MACOS_STATUS="❌ FAILED"
        WATCHOS_STATUS="❌ FAILED"

        if [ "${{ needs.backend-tests.result }}" = "success" ]; then
          BACKEND_STATUS="✅ PASSED"
        fi

        if [ "${{ needs.ios-tests.result }}" = "success" ]; then
          IOS_STATUS="✅ PASSED"
        fi

        if [ "${{ needs.macos-tests.result }}" = "success" ]; then
          MACOS_STATUS="✅ PASSED"
        fi

        if [ "${{ needs.watchos-tests.result }}" = "success" ]; then
          WATCHOS_STATUS="✅ PASSED"
        fi

        echo "- Backend: $BACKEND_STATUS" >> final-report.md
        echo "- iOS: $IOS_STATUS" >> final-report.md
        echo "- macOS: $MACOS_STATUS" >> final-report.md
        echo "- watchOS: $WATCHOS_STATUS" >> final-report.md
        echo "" >> final-report.md

        # Calculate totals
        TOTAL_TESTS=$(find . -name "*.xml" -path "*/surefire-reports/*" -exec grep -h "<testsuite" {} \; 2>/dev/null | sed 's/.*tests="\([^"]*\)".*/\1/g' | awk '{sum += $1} END {print sum}')
        TOTAL_FAILURES=$(find . -name "*.xml" -path "*/surefire-reports/*" -exec grep -h "<testsuite" {} \; 2>/dev/null | sed 's/.*failures="\([^"]*\)".*/\1/g' | awk '{sum += $1} END {print sum}')
        TOTAL_ERRORS=$(find . -name "*.xml" -path "*/surefire-reports/*" -exec grep -h "<testsuite" {} \; 2>/dev/null | sed 's/.*errors="\([^"]*\)".*/\1/g' | awk '{sum += $1} END {print sum}')

        echo "## 📊 Test Metrics" >> final-report.md
        echo "- **Total Backend Tests:** ${TOTAL_TESTS:-0}" >> final-report.md
        echo "- **Backend Failures:** ${TOTAL_FAILURES:-0}" >> final-report.md
        echo "- **Backend Errors:** ${TOTAL_ERRORS:-0}" >> final-report.md
        echo "- **Coverage:** Jacoco reports generated" >> final-report.md

    - name: Upload final comprehensive report
      uses: actions/upload-artifact@v4
      with:
        name: comprehensive-test-report
        path: final-report.md

    - name: Send macOS Notification
      run: |
        # Create notification summary
        SUMMARY="Test Suite Complete

Backend: $([ "${{ needs.backend-tests.result }}" = "success" ] && echo "✅ PASSED" || echo "❌ FAILED")
iOS: $([ "${{ needs.ios-tests.result }}" = "success" ] && echo "✅ PASSED" || echo "❌ FAILED")
macOS: $([ "${{ needs.macos-tests.result }}" = "success" ] && echo "✅ PASSED" || echo "❌ FAILED")
watchOS: $([ "${{ needs.watchos-tests.result }}" = "success" ] && echo "✅ PASSED" || echo "❌ FAILED")

Commit: ${{ github.sha }}"

        # macOS notification
        osascript -e "display notification \"$SUMMARY\" with title \"TimeBeam Test Suite\" subtitle \"Tests Complete\" sound name \"Glass\""

        echo "macOS notification sent with test summary"

    - name: Comment PR with results
      if: github.event_name == 'pull_request'
      uses: actions/github-script@v7
      with:
        script: |
          const fs = require('fs');
          const report = fs.readFileSync('final-report.md', 'utf8');

          github.rest.issues.createComment({
            issue_number: context.issue.number,
            owner: context.repo.owner,
            repo: context.repo.repo,
            body: report
          });
