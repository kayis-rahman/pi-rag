# ============================================================================
# Synapse Environment Variables
# Copy this file to .env and fill in your actual values
# The .env file is gitignored - never commit it!
# ============================================================================

# -----------------------------------------------------------------------------
# API Keys (Required for external LLM providers)
# -----------------------------------------------------------------------------

# Anthropic API key for Claude models
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key-here

# GPUHub API key for vLLM (Qwen) models
# Get yours from your GPUHub dashboard
GPUHUB_API_KEY=your-gpuhub-key-here

# -----------------------------------------------------------------------------
# Optional: Qdrant API Key (for secured semantic memory)
# -----------------------------------------------------------------------------
# MEMORY_SEMANTIC_QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Grafana Admin Credentials
# -----------------------------------------------------------------------------
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
