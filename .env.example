# Synapse Environment Configuration
# Copy to .env and fill in values

# App
APP_ENV=development
DEBUG=true
PI_HOSTNAME=dietpi.local
PI_USER=pi

# LLM (llama.cpp)
LLAMA_HOST=http://192.168.0.100:8080
LLAMA_MODEL=bartowski/google_gemma-4-E2B-it-GGUF:Q4_0
LLAMA_IDLE_TIMEOUT=300

# Fallback LLM (GPUHub)
GPUHUB_API_KEY=
GPUHUB_ENDPOINT=
GPUHUB_MODEL=qwen3-27b

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Gmail
GMAIL_API_ENABLED=false
GMAIL_CREDENTIALS_PATH=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=kayis-rahman
GITHUB_PROJECT_NUMBER=7

# iCal (comma-separated URLs)
# ICAL_URLS=

# Voice
WHISPER_MODEL=indicwhisper-medium
PARLER_TTS_ENDPOINT=

# Open WebUI
OPENWEBUI_URL=http://localhost:8080
